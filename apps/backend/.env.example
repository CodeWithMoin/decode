DECODE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/decode
DECODE_REDIS_URL=redis://localhost:6379/0
DECODE_FRONTEND_ORIGIN=http://localhost:3000
DECODE_ACTOR_ID=internal-private-beta-user
DECODE_ENVIRONMENT=development
DECODE_TRUSTED_ACCESS_BOUNDARY_CONFIRMED=false
DECODE_OBJECT_STORE=local
DECODE_LOCAL_OBJECT_ROOT=.data/objects
