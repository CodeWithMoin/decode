DECODE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/decode
DECODE_REDIS_URL=redis://localhost:6379/0
DECODE_FRONTEND_ORIGIN=http://localhost:3000
DECODE_ACTOR_ID=internal-private-beta-user
DECODE_ENVIRONMENT=development
DECODE_TRUSTED_ACCESS_BOUNDARY_CONFIRMED=false
DECODE_OBJECT_STORE=local
DECODE_LOCAL_OBJECT_ROOT=.data/objects
# For R2: DECODE_R2_ENDPOINT_URL, DECODE_R2_ACCESS_KEY_ID,
# DECODE_R2_SECRET_ACCESS_KEY and DECODE_R2_BUCKET.

# Departments. 'fake' is the deterministic fixture and needs no key; 'openai'
# runs the real Intake department and needs DECODE_OPENAI_API_KEY.
DECODE_INTAKE=fake
DECODE_ARCHITECT=fake
DECODE_AUTHOR=fake
DECODE_VISUALIZER=fake
DECODE_EVALUATOR=fake
# The side-chat orchestrator: 'fake' is the deterministic rule brain, 'openai'
# the LLM behind the same contract (needs DECODE_OPENAI_API_KEY).
DECODE_ORCHESTRATOR=fake
# DECODE_OPENAI_API_KEY=sk-...
# Generation and evaluation can use different models while sharing credentials.
# DECODE_OPENAI_MODEL=gpt-5.6-luna
# DECODE_OPENAI_EVALUATOR_MODEL=gpt-5.6-luna

# Voice. 'fake' is the deterministic fixture; 'fish_audio' runs real TTS.
DECODE_VOICE=fake
# DECODE_FISH_AUDIO_API_KEY=...
# DECODE_FISH_AUDIO_BASE_URL=https://api.fish.audio
# The voice model id from fish.audio (the /m/<id> in a voice's URL), not a name.
# DECODE_FISH_AUDIO_REFERENCE_ID=933563129e564b19a115bedd57b7406a
# TTS backbone header. Defaults to the free tier; paid keys can use s2-pro or s1.
# DECODE_FISH_AUDIO_MODEL=s2.1-pro-free

# Renderer. The worker shells out to a Node.js Remotion script.
# DECODE_RENDER_CWD=apps/frontend
# DECODE_RENDER_OUTPUT_DIR=apps/frontend/public/renders
# DECODE_RENDER_TIMEOUT_SECONDS=300

# Tracing. Optional and off by default. Start the stack with 'make langfuse',
# create a project at http://localhost:3001, then paste its keys here and
# restart the worker. Self-hosted rather than cloud because traces carry the
# creator's source material — see decode/departments/tracing.py.
# DECODE_LANGFUSE_PUBLIC_KEY=pk-lf-...
# DECODE_LANGFUSE_SECRET_KEY=sk-lf-...
DECODE_LANGFUSE_HOST=http://localhost:3001

# Cost circuit-breakers. Jobs are the unit of spend (one job = one model-backed
# stage; a full build is ~5), chat turns are one model call each, and the
# concurrency cap bounds simultaneous provider calls across the whole worker.
# Refusals are 409/429 with creator-language messages; budgets reset at midnight.
# DECODE_DAILY_PROJECT_JOB_BUDGET=60
# DECODE_DAILY_PROJECT_CHAT_BUDGET=200
# DECODE_MAX_CONCURRENT_MODEL_CALLS=4
# Hard dollar ceiling per project per day, summed from recorded usage costs.
# DECODE_DAILY_PROJECT_COST_LIMIT_USD=5.0
